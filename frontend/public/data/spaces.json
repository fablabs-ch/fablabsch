setzen kannst.\n\nNeben Maschinen (3D-Drucker, Lasercutter, CNC-Fräse, uvm.) und Werkzeugen zur digitalen Produktion, bietet das FabLab allen Interessierten Grund- und weiterführende Kurse an, um die Realisierung ihrer Ideen zu erleichtern, z.B. 3D-Design, 3D-Druck oder Programmierung von Mikroprozessoren.","city":"Winterthur","zip":"8406","street":"Technoparkstrasse 2","country_code":"CH","state_code":"","latitude":47.494276,"longitude":8.716498,"founded":"2014-03-14T00:00:00.000Z","email":"info@fablabwinti.ch","website":"https://www.fablabwinti.ch/","facebook":"FabLab.winti","twitter":"FabLabWinti","language":"DE","events_ics":"","members":180,"fablabsio":"fablabwinti","machines":[{"ref":"Ultimaker Original","id":"e7f91522-5f17-472b-a3b4-059c23eeaf57","spaceId":"fablab-winti"},{"ref":"Lasersaur","power":"100W","id":"4099981f-067c-43d6-b9fe-48b13e5879c1","spaceId":"fablab-winti"},{"ref":"Lathe","id":"5db5fcd7-c728-441f-8b34-d9d6312b6b05","spaceId":"fablab-winti"},{"ref":"Curio","id":"0ae3e0bf-3679-47c8-a3e3-27d735818456","spaceId":"fablab-winti"},{"ref":"OPTImill BF 20LVario","id":"ad2595e0-7cb9-4c15-9404-d84bbab6471b","spaceId":"fablab-winti"}],"id":"fablab-winti","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-winti.yml","fallback":false,"name":"fablab-winti"}},{"name":"FabLab Zug","description":"","city":"Zug","zip":"6300","street":"Oberallmendstrasse 18","country_code":"CH","state_code":"ZG","latitude":47.1814157,"longitude":8.5216881,"founded":"2019-03-01T00:00:00.000Z","email":"info@fablab-zug.ch","website":"https://fablab-zug.ch/","facebook":"FabLab-ZUG-2181693758740727","twitter":null,"language":"DE","events_ics":"","fablabsio":"fablabzug","machines":[{"ref":"Ultimaker 2+","id":"0f8147b9-a03f-47ea-9c64-671225d9f682","spaceId":"fablab-zug"}],"id":"fablab-zug","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-zug.yml","fallback":false,"name":"fablab-zug"}},{"name":"FabLab Zürich","description":"Das FabLab Zürich ist eine offene HighTech-Werkstatt.","city":"Zürich","zip":"8004","street":"Zimmerlistr. 6","country_code":"CH","state_code":"ZH","latitude":47.3839493,"longitude":8.5100603,"founded":null,"email":"info@zurich.fablab.ch","website":"https://zurich.fablab.ch/","facebook":"fablabzurich","twitter":"fablabzurich","language":"DE","events_ics":"","fablabsio":"fablabzurich","machines":[],"id":"fablab-zurich","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-zurich.yml","fallback":false,"name":"fablab-zurich"}},{"name":"Makerspace & FabLab Berner Oberland","description":"","city":"Interlaken","zip":"3800","street":"Dammweg 9","country_code":"CH","state_code":"BE","latitude":46.6922763,"longitude":7.8765751,"founded":"2020-09-19T00:00:00.000Z","email":"info@eigermaker.ch","website":"https://eigermaker.ch/","facebook":"eigermaker","twitter":null,"language":"DE","events_ics":"","machines":[],"id":"makerspace-fablab-berner-oberland","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/makerspace-fablab-berner-oberland.yml","fallback":false,"name":"makerspace-fablab-berner-oberland"}},{"name":"Makerspace Reinach","description":"Bastelst du gerne mit Elektronik? Reparierst Du gerne Dinge, oder möchtest es lernen? Themen wie Arduino, Raspberry Pi, ESP8266, Maschine Learning, IoT, Elektronik, 3D Druck, Javascript, Webentwicklung und Modellbau interessieren Dich? Dann mach bei uns mit.","city":"Reinach","zip":"4153","street":"Schulgasse 1","country_code":"CH","state_code":"BL","latitude":47.49379,"longitude":7.59045,"founded":"2021-09-16T00:00:00.000Z","email":"info@makerspace-reinach.ch","website":"https://makerspace-reinach.ch/","twitter":"MakerspaceRein1","language":"de","events_ics":"","members":20,"fablabsio":"makerspacereinach","machines":[{"ref":"OMTech_100W","power":"100W","id":"ca13a7d5-b3dd-4da1-8525-b8367852b211","spaceId":"makerspace-reinach"}],"id":"makerspace-reinach","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/makerspace-reinach.yml","fallback":false,"name":"makerspace-reinach"}},{"name":"FabLab Makerspace Rheinfelden","description":"Der Makerspace Fablab Rheinfelden ist der Treffpunkt in Rheinfelden AG für Tüftler, Bastler und alle Technikbegeisterten. Die Bearbeitung von Holz und Metall sowie die Entwicklung von elektronischen Schaltungen und Software sind nur einige Themen, mit denen du dich an diesem Ort auseinandersetzen kannst.","city":"Rheinfelden","zip":"4310","street":"Quellenstrasse 37","country_code":"CH","state_code":"","latitude":47.5495128,"longitude":7.7860864,"founded":"2015-05-01T00:00:00.000Z","email":"info@makerspace-rheinfelden.ch","website":"https://www.makerspace-rheinfelden.ch","facebook":"makerspacerheinfelden","twitter":"","language":"de","events_ics":"","members":70,"fablabsio":"fablabmakerspacerheinfelden","machines":[],"id":"makerspace-rheinfelden","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/makerspace-rheinfelden.yml","fallback":false,"name":"makerspace-rheinfelden"}},{"name":"MonFabLab","description":"MonFabLab C'est un lieu - d'apprentissage et de formation. - pour échanger et concrétiser des projets. - pour fabriquer différents objets selon les ressources du FabLab. - pour réparer ou modifier des objets ou des appareils.","city":"genthod","zip":"1294","street":"Route de valavran 139","country_code":"CH","state_code":"Genève","latitude":46.264968,"longitude":6.154844,"founded":"2020-06-15T00:00:00.000Z","email":"info@monfablab.ch","website":"https://www.monfablab.ch","facebook":"fablab1294","twitter":null,"language":"FR","events_ics":"","machines":[],"id":"mon-fablab","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/mon-fablab.yml","fallback":false,"name":"mon-fablab"}},{"name":"Onl'fait","description":"En octobre 2017, l’association Onl’fait a ouvert à Genève le premier Fab Lab genevois à vocation pédagogique, un espace ouvert à toutes et tous autour de l'artisanat numérique. Onl’fait met à la disposition de sa communauté les ressources techniques, technologiques et humaines pour construire, réparer, partager, essayer, se planter, recommencer, développer, reconstruire, révolutionner un concept, un prototype, un produit au sein d’une communauté éclectique de passionné/e/s.\nLe Fab Lab Onl’fait est aussi un lieu de rencontres intergénérationnelles et multi-culturelles pour réfléchir à une approche écologique, citoyenne et durable de la science, de la technologie et de la consommation.","city":"Plan-les-Ouates","zip":"1228","street":"Route de la Galaise 23/25 A","country_code":"CH","state_code":"GE","latitude":46.166373,"longitude":6.103154,"founded":"2017-10-12T00:00:00.000Z","email":"contact@onlfait.ch","website":"https://www.onlfait.ch","facebook":"onlfait","twitter":"FabLabOnlfait","language":"FR, EN, IT, ES","events_ics":"","fablabsio":"onlfait","machines":[{"ref":"Cameo","id":"53ae2ceb-9d46-464a-a9dd-f1ce1eebccbd","spaceId":"onlfait"},{"ref":"Itopie","id":"08c2cf2a-0c57-43ea-a8ce-fe3ad4acc18e","spaceId":"onlfait"},{"ref":"1060SP","power":"90W","id":"f49b5f26-099d-41c9-b959-09a4b9de2b00","spaceId":"onlfait"},{"ref":"ShopBot Buddy 48''","id":"cd2a9a39-23c2-4116-9069-987927d9a814","spaceId":"onlfait"},{"ref":"CR-20","id":"45578361-2f70-4b10-b641-fcf243a20100","spaceId":"onlfait"},{"ref":"Ratrig V-Core 3","id":"8c523aff-5ce3-49be-b89c-a06ea08d8828","spaceId":"onlfait"},{"ref":"Photon","id":"6a6a49ff-39d0-49c5-b0d7-dbf5acb8e9e4","spaceId":"onlfait"},{"ref":"Brother Innov-is F480","id":"b2426337-24da-40ec-a523-dffb21ec241c","spaceId":"onlfait"},{"ref":"Shaper origin","id":"34f2312a-54b0-4874-8aa3-834b4ff2627e","spaceId":"onlfait"},{"ref":"Vacuum former 725FLB","id":"014c3c54-dbb7-4a95-afbc-c7f720d8cad0","spaceId":"onlfait"}],"id":"onlfait","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/onlfait.yml","fallback":false,"name":"onlfait"}},{"name":"Quartierwerkstatt Viktoria","description":"Die Freizeitwerkstätte im Berner Nordquartier. Die Quartierwerkstatt setzt sich zusammen aus dem Fablab,\nmit Elektronikbereich und den unten aufgeführten Maschinen, einem grossen Holz- und Metallbereich, sowie einer\nLackierkabine. Der Holzbereich besteht unter anderem aus einer Tischreissäge, einer Hobelbank, mehreren\nBandkreissägen, einer Kapp-/Gehrungssäge, einer Drechselmaschine, einer vertikalen Plattensäge (Striebig),\nsowie diversen Handmaschinen. Der Metallbereich besteht aus einem Schweiss- und Lötbereich, einer Metallkreissäge,\neiner Bohr-/Fräsmaschine, einer Drehbank, sowie mehreren Handmaschinen. Mehr Informationen findest du auf unserer\nWebseite.","city":"Bern","zip":"3013","street":"Gotthelfstrasse 29","country_code":"CH","state_code":"BE","latitude":46.9552889,"longitude":7.4513925,"founded":"2015-08-15T00:00:00.000Z","email":"fablab@quartierwerkstatt-viktoria.ch","website":"https://www.quartierwerkstatt-viktoria.ch/","language":"DE","machines":[{"ref":"Viktoria CnC","id":"c45866e5-2904-4d29-99be-00530bf75cf6","spaceId":"quartierwerkstatt-viktoria"},{"ref":"AKJ6090","id":"8375db8a-f104-4b52-86f2-f5d0297dab26","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Prusa XL","id":"25d663dd-87f3-459a-84b3-3be0ea3cb0f9","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Prusa MK3S","id":"92df2026-2b2f-4a07-aefc-611c0ed6807c","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Prusa Mini+","id":"6434bfa4-22b5-4947-b6ca-0a9de3ca49db","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Photon","id":"5bc1d5d6-deff-43b2-811b-2bc3dc41eada","spaceId":"quartierwerkstatt-viktoria"},{"ref":"SL 740","id":"798c8bb5-650e-4793-a07b-0ad41cbf213a","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Shapertools Origin","id":"96fe132f-9fdd-4c9c-bc26-7d9151d45937","spaceId":"quartierwerkstatt-viktoria"},{"ref":"Schulze XXL","id":"3ac73fa4-f750-438b-8b8b-3d965e62aad3","spaceId":"quartierwerkstatt-viktoria"}],"id":"quartierwerkstatt-viktoria","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/quartierwerkstatt-viktoria.yml","fallback":false,"name":"quartierwerkstatt-viktoria"}},{"name":"SDG Solution Space","description":"The University of Geneva (UNIGE) is running the Geneva SDG Solution Space, a true workshop where students, researchers, humanitarian workers and UN experts will gather to provide practical answers to the challenges of sustainable development. The focus will be on the 17 SDGs — Sustainable Development Goals — set by the United Nations in 2015. This new 300 m2 facility opened its doors on Friday 12th of May, on the occasion of the third Open Geneva Hackathon which brings innovation to the heart of the city. It is housed in the Biotech Innovation Park Campus in Sécheron, in the centre of International Geneva. Users will enjoy state-of-the-art digital technology (such as 3D printers and laser cutters) to help them develop prototypes, validate projects and, more broadly, test the suitability of their ideas.","city":"Genève","zip":"1202","street":"Avenue de Sécheron 15","country_code":"CH","state_code":"GE","latitude":46.2206964,"longitude":6.1448708,"founded":null,"email":"","website":"https://sdgsolutionspace.org/","facebook":"","twitter":"","language":"fr","events_ics":"","fablabsio":"sdgsolutionspace","machines":[],"id":"sdg-solution-space","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/sdg-solution-space.yml","fallback":false,"name":"sdg-solution-space"}},{"name":"Starship Factory","description":"Was wir in der Starship Factory haben ist u.a.\n\n* Diverse 3D-Drucker für kleine Plastikteile (für Vorlagen siehe z.B. thingiverse.com)\n* eine CNC-Maschine (z.B. für Bühnenbuchstaben aus Holzplatten, siehe auch thingiverse)\n* Laser zum Gravieren und dünnere Materialien schneiden (z.B. für Wasserzeichen auf deinem Material)\n* Nähmaschinen (z.B. für Cosplay-Verkleidungen)\n* Transferdruck und einfarbiger Siebdruck (z.B. für kleine Auflagen von Vereinspullis)\n* sehr viel Sachen für Elektronik (diverse Lötstationen, Osziloskope, EL-Draht für leuchtende Verkleidugen, Rapsberry-Pis, etc.)\n* bald: eine automatische Strickmaschine (z.B. für eigene Topflappen)\n\nEinen ersten Eindruck bekommst Du auch von unseren Fotogalerien auf\n<a href=\"https://www.instagram.com/starship_factory/\">Insta</a>.\n\nWir sind im WerkKlybeck.ch , das uns einen grossen Forumsraum bietet, sowie den Austausch mit einer Werkstatt und einem Atelierkollektiv von Medien-Künstler*innen.","city":"Basel","zip":"4057","street":"Klybeckstrasse 141, WERK Raumkollektiv / Gebäude K-102","country_code":"CH","state_code":"BS","latitude":47.5749222,"longitude":7.5872848,"founded":"2013-08-25T00:00:00.000Z","email":"pr@lists.starship-factory.ch","website":"https://starship-factory.ch/","facebook":"StarshipFactory","twitter":"StarshipFactory","language":"de","events_ics":"https://calendar.google.com/calendar/ical/1lt0poash68dlli86ertv1kbcg%40group.calendar.google.com/public/basic.ics","members":30,"fablabsio":"starshipfactory","machines":[],"id":"starship-factory","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/starship-factory.yml","fallback":false,"name":"starship-factory"}},{"name":"Y-FabLab","description":"Y-FabLab est une association à but non lucratif dont la mission consiste à mettre à disposition de la population nord-vaudoise un lieu de créativité et de fabrication numérique ouvert à toutes et à tous.\nLa spécificité par rapport à d'autres fablab est peut-être de disposer d'un atelier soudure, d'un atelier bois et d'un atelier mécanique ne plus des outils numériques habituels\ncategories","city":"Yverdon-les-Bains","zip":"1400","street":"Av. des Sports 5","country_code":"CH","state_code":"","latitude":46.782243,"longitude":6.648779,"founded":"2017-05-01T00:00:00.000Z","email":"info@y-fablab.ch","website":"https://www.y-fablab.ch","facebook":"Y-FabLab","twitter":"","language":"FR","events_ics":"https://calendar.google.com/calendar/ical/6sp8qpmmr83g46oshrclekdl9o%40group.calendar.google.com/public/basic.ics","machines":[{"ref":"Cameo","id":"434009fe-ed4a-46a3-a22d-c1f4dc363ea0","spaceId":"y-fablab"},{"ref":"BCL-1309X","id":"48a7e1f4-b9ca-4dc7-bd98-3862a0722e0b","spaceId":"y-fablab"},{"ref":"Prusa MK3S","id":"b76aa0a9-70d2-4990-8108-21f9288c6298","spaceId":"y-fablab"},{"ref":"Bambu Lab P1S","id":"98fb53ae-6cbe-4abe-acf5-f2e485730d36","spaceId":"y-fablab"},{"ref":"CR-10S pro","id":"4cf0140a-0198-4305-a6ed-5f03247f78fb","spaceId":"y-fablab"},{"ref":"Schaublin 102","id":"1a654c4d-4550-4c28-9548-c41e66ff5962","spaceId":"y-fablab"},{"ref":"CHARLY 4T","id":"baf6e96a-3667-43b2-aa13-e3b9399bac96","spaceId":"y-fablab"},{"ref":"CHARLY DMC 600","id":"77ba3461-f80f-4453-979c-af30f4c96120","spaceId":"y-fablab"},{"ref":"Kiener & Wittlin","id":"a28a1e61-76ae-424f-874a-0d01b4e777e5","spaceId":"y-fablab"},{"ref":"Mini-Max ST3","id":"311c7bac-2a37-458c-9deb-8ef0a5203197","spaceId":"y-fablab"},{"ref":"Mini-Max FS30","id":"bd853944-d764-4d0d-a978-55a45db757e3","spaceId":"y-fablab"},{"ref":"Mini-Max S-45","id":"22204d8e-f9c4-46ec-83d2-237d4f78131a","spaceId":"y-fablab"},{"ref":"Flott SB 16 ST","id":"1ff03f7f-d603-4f6e-8b7c-cac9eb643b4a","spaceId":"y-fablab"},{"ref":"CNC 3020","id":"9545d0f7-acfc-4def-88a4-5728c511463d","spaceId":"y-fablab"},{"ref":"Metabo KGS 305 M","id":"6ae4f10b-352b-45fa-9a87-3c53f124231f","spaceId":"y-fablab"},{"ref":"finesse","id":"432cfaf1-5f0f-4bd8-b287-4492dadd91c2","spaceId":"y-fablab"},{"ref":"Thomas Mod 250 export","id":"63ee6947-c853-4a05-88c7-b32aa3824fa5","spaceId":"y-fablab"},{"ref":"MinarcMig 190 auto","id":"3c1f8d36-1905-45ad-