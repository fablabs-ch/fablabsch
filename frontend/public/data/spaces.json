:"Mini Mill","power":"5,6kW","id":"a75ccff6-7bc1-4c72-bc4b-ba61a9114689","spaceId":"ceff-lab"},{"ref":"CR-10S pro","id":"9d27afcb-1489-4244-a3d5-01776bfb600a","spaceId":"ceff-lab"},{"ref":"Ender-3 Pro","id":"c4dafb2f-bfb8-4fc5-9e3b-205ee69e67d1","spaceId":"ceff-lab"}],"id":"ceff-lab","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/ceff-lab.yml","fallback":false,"name":"ceff-lab"}},{"name":"FabLab Bern","description":"Wer Zugang braucht zu 3D Druckern, Lasercutter, Drehbank, Bohrmaschine und anderen Werkzeugen, die nicht gerade in jedem Haushalt stehen, ist bei uns richtig.\nDas FabLab steht Einzelpersonen, Gruppen und Firmen zur Verfügung und kann während unseren Öffnungszeiten gemäss den Nutzungsgebühren benutzt werden.\nVoraussetzung ist das erfolgreiche Bestehen des Einführungskurses.\nWir bieten attraktive Gebühren auf Stunden- oder Halbtagesbasis. Besitzer der Jahreskarte erhalten einen Rabatt auf die Nutzungsgebühren.","city":"Bern","zip":"3007","street":"Eigerstrasse 12","country_code":"CH","state_code":"BE","latitude":46.9403801,"longitude":7.4328098,"founded":null,"email":"","website":"https://fablab-bern.ch","facebook":"fablab.bern","twitter":"FabLab_Bern","language":"DE","events_ics":"","fablabsio":"fablabbern","machines":[{"ref":"Mars 90 PLUS","power":"90W","id":"66a76208-1725-4e96-8824-36c1ca9d97eb","spaceId":"fablab-bern"},{"ref":"Ultimaker 2","id":"d3fbc3e5-a1ba-4e6b-9575-8357d75686f3","spaceId":"fablab-bern"},{"ref":"Ultimaker Original+","id":"539e7cac-7b0c-4ad9-adb6-60d9eb550de0","spaceId":"fablab-bern"},{"ref":"Ultimaker Original","id":"f87f38f1-d98f-4e13-b723-6e87a8c74dc3","spaceId":"fablab-bern"},{"ref":"Printrbot Play","id":"cf042ab8-bf54-4e18-8f00-9b20290ff6d1","spaceId":"fablab-bern"},{"ref":"Cameo","id":"be283957-f6b7-4052-bdcc-409dd3cbac5b","spaceId":"fablab-bern"}],"id":"fablab-bern","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-bern.yml","fallback":false,"name":"fablab-bern"}},{"name":"FabLab Burgdorf-Emmental","description":"","city":"Burgdorf","zip":"3400","street":"Kirchbergstrasse 23a","country_code":"CH","state_code":"","latitude":47.0614776,"longitude":7.6179872,"founded":"2017-04-01T00:00:00.000Z","email":"","website":"https://fablab-burgdorf.ch","facebook":"","twitter":"","language":"de","events_ics":"","machines":[],"id":"fablab-burgdorf-emmental","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-burgdorf-emmental.yml","fallback":false,"name":"fablab-burgdorf-emmental"}},{"name":"FabLab Fribourg - Freiburg","description":"Les FabLabs sont des espaces ouverts au public, équipés et animés pour permettre à tout un chacun de fabriquer des objets de tous genres.\n\nEntre imprimantes 3D et systèmes électroniques de prise en main de plus en plus facile, l'avenir appartient aux FabLabs, aux échanges et à l'entraide.\n\nDébut juin 2013 à Fribourg, un groupe s'est constitué spontanément afin de réaliser ce projet.\n\nSi vous êtes intéressé, pour être un des fondateurs, animateurs ou utilisateurs vous pouvez nous contacter :\ninfo@fablab-fribourg.ch","city":"Fribourg","zip":"1700","street":"Passage du Cardinal 1","country_code":"CH","state_code":"FR","latitude":46.7985001,"longitude":7.1484299,"founded":"2013-01-01T00:00:00.000Z","email":"info@fablab-fribourg.ch","website":"https://www.fablab-fribourg.ch/","facebook":"FabLabFribourg","twitter":"FablabFR","language":"FR/DE","events_ics":"https://calendar.google.com/calendar/ical/nulu08ntleed9c5peukoeaifl8%40group.calendar.google.com/public/basic.ics","events_ics_filter":"#\\w*","fablabsio":"fablabfribourg","machines":[{"ref":"PCUT CT","id":"7e9d4326-89d6-423c-a820-09c3a276f2be","spaceId":"fablab-fribourg"},{"ref":"Speedy 300","power":"60W","id":"b60e20a6-fb5a-47c2-9ac4-53b1c73a2c52","spaceId":"fablab-fribourg"},{"ref":"Replicator 5th Generation","nozzle_size":"0.4mm","id":"d2a01be6-2dbd-4ab8-a1dc-0ec0b368ce46","spaceId":"fablab-fribourg"},{"ref":"CNC 3040","id":"e6726647-39fc-4492-9cdb-ac18a473b63c","spaceId":"fablab-fribourg"},{"ref":"Qidi Tech 1","id":"04f7c8a1-d126-4d2f-8286-ef55bc4af085","spaceId":"fablab-fribourg"},{"ref":"Prusa MK3S+","id":"72712cae-e3bc-42ec-9e2a-eea170abf214","spaceId":"fablab-fribourg"},{"ref":"PCUT PC-43","id":"3f96775e-c076-44ee-bc26-ebe488ec8865","spaceId":"fablab-fribourg"},{"ref":"Press T-Shirt","id":"7338f0e2-2775-428d-bfe6-a0e23a50664d","spaceId":"fablab-fribourg"}],"id":"fablab-fribourg","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-fribourg.yml","fallback":false,"name":"fablab-fribourg"}},{"name":"FabLab La Chaux-de-Fonds","description":"Logé au coeur des Montagnes neuchâteloises, le FabLab La Chaux-de-Fonds est organisé en association et jouit d’un espace du plus de 200m2 en plein centre ville.\n\nNous sommes heureux de pouvoir également vous proposer, en plus des éléments de base qui composent un fablab, des équipements plus “conventionnels” tels qu’un atelier de mécanique ainsi qu’un atelier pour travailler le bois.\n\nLes locaux ont été pensé dans le but que les divers projets puissent se réaliser de A à Z agréablement, tant au niveau de la diversité des équipements que de leur agencement.","city":"La Chaux-de-Fonds","zip":"2300","street":"Rue de la Serre 68","country_code":"CH","state_code":"","latitude":47.0996587,"longitude":6.8231281,"founded":"2018-09-01T00:00:00.000Z","email":"info@fablab-chaux-de-fonds.ch","website":"https://www.fablab-chaux-de-fonds.ch","facebook":"FabLabChauxDeFonds","twitter":"FabLab_CDF","language":"","events_ics":"","fablabsio":"fablabchauxdefonds","machines":[],"id":"fablab-la-chaux-de-fonds","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-la-chaux-de-fonds.yml","fallback":false,"name":"fablab-la-chaux-de-fonds"}},{"name":"FabLab La Côte","description":"L'association du FabLab de la Côte est à but non lucratif et poursuit le but de rendre l'innovation accessible à tous.\n\nPour y parvenir nous mettons à disposition des machines, du matériel et des outils à des prix abordables. Des activités créatives et d'initiations aux domaines techniques sont organisées","city":"Arzier-le-Muids","zip":"1273","street":"Rue du Village 8A","country_code":"CH","state_code":"VD","latitude":46.4594199,"longitude":6.2095767,"founded":"2013-11-25T00:00:00.000Z","email":"info@fablab-lacote.ch","website":"https://www.fablab-lacote.ch","facebook":"FabLabLaCote","twitter":"FabLabLaCote","language":"FR","events_ics":"https://calendar.google.com/calendar/ical/of3ji1ep9d7djkquvuma3hj31o%40group.calendar.google.com/public/basic.ics","members":30,"fablabsio":"fablablacote","machines":[{"ref":"Speedy 100","power":"150W","id":"da7e2b31-40a6-43c1-ab21-3f75dec70972","spaceId":"fablab-la-cote"},{"ref":"Cameo","id":"5993c340-ad0b-4358-9985-7bf59ddcddde","spaceId":"fablab-la-cote"},{"ref":"Prusa MK3S+","id":"c8ba41b3-5c8d-4720-acad-a1748a403a67","spaceId":"fablab-la-cote"},{"ref":"StepCraft","id":"2f2442a2-ee59-4589-b282-e34b1b4c41c4","spaceId":"fablab-la-cote"},{"ref":"Press T-Shirt","id":"03bba194-634a-4f8f-8ef2-f48291f3a25e","spaceId":"fablab-la-cote"}],"id":"fablab-la-cote","fileInfo":{"extension":".yml","directory":"../content/spaces","subfolder":"spaces","path":"../content/spaces/fablab-la-cote.yml","fallback":false,"name":"fablab-la-cote"}},{"name":"FabLab Luzern","description":"","city":"Lucerne","zip":"6048","street":"Technikumstrasse 21, Trakt I, Horw","country_code":"CH","state_code":"","latitude":47.0144456547552,"longitude":8.30506351957399,"founded":"2010-01-01T00:00:00.000Z","email":"labmanager@fablab-luzern.ch","website":"https://fablab-luzern.ch/","facebook":"fablab.luzern","twitter":"fablabluzern","language":"DE","events_ics":"","machines":[{"ref":"PA8050","id":"9d6d2e90-26b3-4521-88ab-c397d2f